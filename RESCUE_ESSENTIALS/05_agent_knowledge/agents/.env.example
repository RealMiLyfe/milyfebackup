# ═══════════════════════════════════════════════════════════════
# HTC AGENTS — Multi-Agent System Configuration
# ═══════════════════════════════════════════════════════════════

# ─── LLM Providers ────────────────────────────────────────────
NVIDIA_NIM_API_KEY=          # Nemotron 120B for COMMANDER
GEMINI_API_KEY=              # Gemini Flash for SCOUT, SENTINEL, ANALYST
GROQ_API_KEY=                # Groq for STORYTELLER, CONNECTOR
ANTHROPIC_API_KEY=           # Claude for BUILDER
OLLAMA_URL=http://host.docker.internal:11434  # Local Ollama for GUARDIAN

# ─── Mattermost ──────────────────────────────────────────────
MATTERMOST_URL=http://mattermost:8065
MATTERMOST_BOT_TOKEN=
MATTERMOST_TEAM=campaign
MATTERMOST_USERNAME=milyfe
MATTERMOST_PASSWORD=

# ─── Memory (Mem0) ───────────────────────────────────────────
MEM0_API_KEY=                # Optional — uses local if empty
MEM0_STORAGE=local           # local | api

# ─── ChromaDB (Episodic Memory) ──────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8100
CHROMA_PERSIST_DIR=/app/data/chromadb

# ─── Redis (State + Cache) ───────────────────────────────────
REDIS_URL=redis://redis:6379/1

# ─── Campaign API (Read-Only) ────────────────────────────────
CAMPAIGN_API_URL=http://htc-campaign-api:8200

# ─── Supabase (Read-Only for Platform Metrics) ───────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── SearXNG (Research) ──────────────────────────────────────
SEARXNG_URL=http://htc-searxng:8080

# ─── ntfy (Alerts) ───────────────────────────────────────────
NTFY_URL=http://htc-ntfy:80
NTFY_TOPIC=chamber

# ─── System ──────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
KNOWLEDGE_PATH=/app/knowledge
BRAIN_PATH=/app/brain
